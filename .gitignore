# Example .gitignore file for custom card.
# An * ensures that everything will be ignored.
*

# Don't ignore directories (so we can look inside them, for other files)
!*/

# You can whitelist files/folders with !, these will not be ignored.
!*.json
!*.ts
!*.cjs
!.prettierrc
!eslint.config.mjs
!.nycrc
!.browserslistrc
!.node-version
!assets/**
!dist/**
!.github/**
!.gitignore
!*.md
!LICENSE
!sonar-project.properties
!yarn.lock
!docs/**
!examples/**
!mkdocs.yml
!*.avif

!scripts/
!scripts/**
!*.sh
!*.mdc
!.cursor/hooks.json
!.cursor/rules/**
!.cursor/skills/**
!.cursor/hooks/**
!.claude/skills/**

!.claude/hooks/**
!.claude/settings.json
# Ignore folders.
node_modules
dist
coverage
.vscode
.DS_Store
.nyc_output